{
  "name": "fuck-ecoflow-docs",
  "version": "1.0.0",
  "description": "Docusaurus documentation for fuck-ecoflow",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "check:media": "node scripts/check-media-guardrails.mjs",
    "check:naming": "node scripts/check-naming-conventions.mjs",
    "optimize:media": "node scripts/optimize-doc-media.mjs",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "changelog": "auto-changelog --commit-limit false --hide-credit -p",
    "format": "prettier --write \"**/*.{js,jsx,mjs,md,css,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,md,css,json}\" --ignore-path .prettierignore",
    "ci": "npm run check:naming && npm run check:media && npm run build",
    "test": "npm run check:naming && npm run check:media",
    "generate:docs-index": "node ./scripts/generate-docs-index.mjs",
    "check:images": "node ./scripts/check-missing-images.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@easyops-cn/docusaurus-search-local": "^0.55.3",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "sharp": "^0.35.2",
    "auto-changelog": "^2.6.0",
    "prettier": "^3.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
